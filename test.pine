//@version=6
indicator("Test Alerts (bar-close flip)", overlay=true)

// ====== INPUTS ======
pair_input  = input.string("EUR_USD", "OANDA Pair (what your bot expects)", confirm=true)
sl_pips     = input.int(10, "SL pips", minval=1)
tp_pips     = input.int(20, "TP pips", minval=0)

// Safety caps (keep in sync with bot .env MAX_SL_PIPS / MAX_TP_PIPS)
max_sl_pips = input.int(10, "MAX SL pips (bot cap)", minval=1)
max_tp_pips = input.int(20, "MAX TP pips (bot cap)", minval=0)

can_trade = (sl_pips <= max_sl_pips) and (tp_pips <= max_tp_pips)

// ====== ID BASE ======
id_base = pair_input + ":" + str.tostring(time)

// ====== JSON BUILDERS ======
open_json(side) =>
    "{\"alert_id\":\"" + id_base + ":open\",\"action\":\"open\",\"side\":\"" + side + "\",\"pair\":\"" + pair_input + "\",\"sl_pips\":" + str.tostring(sl_pips) + ",\"tp_pips\":" + str.tostring(tp_pips) + "}"

// ====== FIRE TEST ALERTS (alternating each bar close) ======
is_even_bar = (bar_index % 2) == 0
if barstate.isconfirmed and can_trade
    alert(open_json(is_even_bar ? "buy" : "sell"), alert.freq_once_per_bar_close)
