//@version=6
indicator("Bot alerts (SMART TRIGGER) + lookback + key levels", overlay=true)

// ====== INPUTS ======
pair_input  = input.string("USD_JPY", "OANDA Pair", confirm=true)
sl_pips     = input.int(25, "Default SL pips", minval=1)
tp_pips     = input.int(50, "Default TP pips", minval=0)
max_sl_pips = input.int(25, "MAX SL pips", minval=1)
max_tp_pips = input.int(50, "MAX TP pips", minval=0)
lookback_n  = input.int(7, "Lookback candles", minval=3, maxval=10)

// Signal & Indicator Settings
fastLen       = input.int(12, "Fast EMA")
slowLen       = input.int(36, "Slow EMA")
ema200Len     = input.int(200, "EMA 200 (Mean)")
rsiLen        = input.int(14, "RSI Len")
adxLen        = input.int(14, "ADX Len")
atrLen        = input.int(14, "ATR Len")
fire_on_close = input.bool(true, "Fire on bar close only")

// IMPORTANT: cap for 24h window to avoid "too many bars back" on small timeframes
bars_24h_cap  = input.int(5000, "Max bars for 24h high/low", minval=500, maxval=5000)

// Overextension threshold (in "pips" units defined by pipSize)
// Meaningfully wider for XAU
overext_fx_pips  = input.float(40.0,  "Overextension threshold (FX pips)", minval=5.0, step=5.0)
overext_xau_pips = input.float(300.0, "Overextension threshold (XAU pips)", minval=50.0, step=50.0)

// ====== PIP SIZE ======
pipSize =
     str.contains(pair_input, "XAU") ? 0.01 :
     str.contains(pair_input, "JPY") ? 0.01 :
     0.0001

// ====== FORMATTERS (reduce payload size) ======
fnum(x)  => str.tostring(x, "#.#####")
fnum2(x) => str.tostring(x, "#.##")

// ====== GLOBAL CALCULATIONS ======
fast    = ta.ema(close, fastLen)
slow    = ta.ema(close, slowLen)
ema200  = ta.ema(close, ema200Len)
rsi     = ta.rsi(close, rsiLen)
[_, _, adx] = ta.dmi(adxLen, adxLen)
atr     = ta.atr(atrLen)

buyCross  = ta.crossover(fast, slow)
sellCross = ta.crossunder(fast, slow)
trendUp   = fast > slow
trendDown = fast < slow

// ====== 24H High/Low (with cap) ======
sec_per_bar = timeframe.in_seconds(timeframe.period)
bars_24h_raw = (sec_per_bar > 0) ? int(math.round(86400 / sec_per_bar)) : 288
bars_24h     = math.max(1, math.min(bars_24h_raw, bars_24h_cap))

high_24h = ta.highest(high, bars_24h)
low_24h  = ta.lowest(low, bars_24h)

// ====== Derived features ======
atr_pips      = atr / pipSize
ema_sep_pips  = math.abs(fast - slow) / pipSize
fast_slope_p  = (fast - fast[1]) / pipSize
slow_slope_p  = (slow - slow[1]) / pipSize
range_pips    = (high - low) / pipSize
regime        = adx >= 20 ? "trend" : "chop"

dist_to_high_24h = (high_24h - close) / pipSize
dist_to_low_24h  = (close - low_24h) / pipSize
dist_to_ema_200  = (close - ema200) / pipSize

rsi_change_3_bars        = rsi - rsi[3]
price_change_3_bars_pips = (close - close[3]) / pipSize

// ====== READINESS GUARD ======
ready = (bar_index >= ema200Len) and (bar_index >= lookback_n) and not na(ema200) and not na(adx) and not na(rsi)

// ====== SMART TRIGGER LOGIC (event-based) ======
// 1) Regime change (trend starting)
isTrendStart = (adx > 20) and (adx[1] <= 20)

// 2) Overextension: trigger only on ENTER/EXIT (not every bar)
overext_thresh = str.contains(pair_input, "XAU") ? overext_xau_pips : overext_fx_pips
overext_now    = math.abs(dist_to_ema_200) > overext_thresh
overext_enter  = overext_now and not overext_now[1]
overext_exit   = (not overext_now) and overext_now[1]

// 3) Trend flipped (useful for closes)
trendFlipped = (trendUp and not trendUp[1]) or (trendDown and not trendDown[1])

// Combine: Only fire if something interesting happened THIS BAR
shouldTrigger = buyCross or sellCross or isTrendStart or trendFlipped or overext_enter or overext_exit

// ====== LOOKBACK JSON GENERATOR ======
get_lookback_json(int n) =>
    string s = "["
    for i = 0 to n - 1
        s += "{"
        s += "\"i\":"          + str.tostring(i) + ","
        s += "\"time_ms\":"    + str.tostring(time[i]) + ","
        s += "\"open\":"       + fnum2(open[i]) + ","
        s += "\"high\":"       + fnum2(high[i]) + ","
        s += "\"low\":"        + fnum2(low[i]) + ","
        s += "\"close\":"      + fnum2(close[i]) + ","
        s += "\"rsi\":"        + fnum(rsi[i]) + ","
        s += "\"adx\":"        + fnum(adx[i]) + ","
        s += "\"range_pips\":" + fnum(range_pips[i]) + ","
        s += "\"trendUp\":"    + str.tostring(trendUp[i]) + ","
        s += "\"trendDown\":"  + str.tostring(trendDown[i])
        s += "}"
        if i < n - 1
            s += ","
    s += "]"
    s

// ====== MAIN ALERT JSON ======
can_fire = (
    ready and
    (sl_pips <= max_sl_pips) and
    (tp_pips <= max_tp_pips) and
    (fire_on_close ? barstate.isconfirmed : true) and
    shouldTrigger
)

if can_fire
    id_base = pair_input + ":" + str.tostring(time) + ":" + str.tostring(bar_index)

    json_payload = (
        "{\"alert_id\":\"" + id_base + ":obs\",\"action\":\"observe\",\"pair\":\"" + pair_input + "\"," +
        "\"sl_pips\":" + str.tostring(sl_pips) + ",\"tp_pips\":" + str.tostring(tp_pips) + "," +
        "\"features\":{" +
            "\"tf\":\"" + timeframe.period + "\"," +
            "\"time_ms\":" + str.tostring(time) + "," +
            "\"volume\":" + str.tostring(volume) + "," +
            "\"range_pips\":" + fnum(range_pips) + "," +
            "\"open\":" + fnum2(open) + "," +
            "\"high\":" + fnum2(high) + "," +
            "\"low\":" + fnum2(low) + "," +
            "\"close\":" + fnum2(close) + "," +
            "\"rsi\":" + fnum(rsi) + "," +
            "\"adx\":" + fnum(adx) + "," +
            "\"atr_pips\":" + fnum(atr_pips) + "," +
            "\"ema_sep_pips\":" + fnum(ema_sep_pips) + "," +
            "\"fast_slope_pips\":" + fnum(fast_slope_p) + "," +
            "\"slow_slope_pips\":" + fnum(slow_slope_p) + "," +
            "\"dist_to_high_24h\":" + fnum(dist_to_high_24h) + "," +
            "\"dist_to_low_24h\":" + fnum(dist_to_low_24h) + "," +
            "\"dist_to_ema_200\":" + fnum(dist_to_ema_200) + "," +
            "\"rsi_change_3_bars\":" + fnum(rsi_change_3_bars) + "," +
            "\"price_change_3_bars_pips\":" + fnum(price_change_3_bars_pips) + "," +
            "\"buyCross\":" + str.tostring(buyCross) + "," +
            "\"sellCross\":" + str.tostring(sellCross) + "," +
            "\"trendUp\":" + str.tostring(trendUp) + "," +
            "\"trendDown\":" + str.tostring(trendDown) + "," +
            "\"regime\":\"" + regime + "\"," +
            "\"lookback\":" + get_lookback_json(lookback_n) +
        "}" +
        "}"
    )

    alert(json_payload, fire_on_close ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)

// ====== VISUALS ======
plot(fast, color=color.blue, title="Fast EMA")
plot(slow, color=color.orange, title="Slow EMA")
plot(ema200, color=color.gray, title="EMA 200", linewidth=2)
plotshape(buyCross,  title="BuyCross",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)
plotshape(sellCross, title="SellCross", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// Visual indicator for when the bot WOULD fire
bgcolor((ready and shouldTrigger) ? color.new(color.yellow, 90) : na, title="Alert Triggered")
